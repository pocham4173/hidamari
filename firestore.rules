rules_version = '2';

service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function usableAccount() {
      return signedIn() && !existsAfter(/databases/$(db)/documents/accountClosures/$(request.auth.uid));
    }

    // サービスへの同意。家族への公開権限とは別に検査する。
    function hasConsent() {
      return usableAccount()
        && existsAfter(/databases/$(db)/documents/consents/$(request.auth.uid))
        && getAfter(/databases/$(db)/documents/consents/$(request.auth.uid)).data.version == '2026-09-19.1'
        && getAfter(/databases/$(db)/documents/consents/$(request.auth.uid)).data.privacyAccepted == true
        && getAfter(/databases/$(db)/documents/consents/$(request.auth.uid)).data.sensitiveAccepted == true
        && getAfter(/databases/$(db)/documents/consents/$(request.auth.uid)).data.sharingAccepted == true;
    }

    match /consents/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create, update: if usableAccount() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['version', 'mode', 'privacyAccepted', 'sensitiveAccepted', 'sharingAccepted', 'subjectBasis', 'acceptedAt'])
        && request.resource.data.version == '2026-09-19.1'
        && request.resource.data.mode in ['honnin', 'kazoku', 'konly']
        && request.resource.data.privacyAccepted == true
        && request.resource.data.sensitiveAccepted == true
        && request.resource.data.sharingAccepted == true
        && request.resource.data.subjectBasis == (request.resource.data.mode == 'honnin' ? 'self' : 'explained-and-agreed')
        && request.resource.data.acceptedAt == request.time;
      // 同意撤回・アカウント削除は同意なしでも行える。
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // 管理者は groups.createdBy のアカウントだけ(作成者。管理者の交代で受け取った人に移る)。画面の role や自己申告は権限に使わない。
    function isOwner(groupId) {
      return signedIn()
        && exists(/databases/$(db)/documents/groups/$(groupId))
        && get(/databases/$(db)/documents/groups/$(groupId)).data.createdBy == request.auth.uid;
    }

    function isActive(groupId) {
      return exists(/databases/$(db)/documents/groups/$(groupId))
        && get(/databases/$(db)/documents/groups/$(groupId)).data.get('deletionState', '') != 'deleting';
    }

    // 同じbatchで削除マーク/削除が入った場合も、通常書込を拒否する。
    function writableGroup(groupId) {
      return usableAccount() && getAfter(/databases/$(db)/documents/groups/$(groupId)).data.get('deletionState', '') != 'deleting';
    }

    function activeOwner(groupId) {
      return isOwner(groupId) && writableGroup(groupId);
    }

    function approvedAfter(groupId) {
      return signedIn() && writableGroup(groupId)
        && getAfter(/databases/$(db)/documents/groups/$(groupId)/members/$(request.auth.uid))
          .data.get('status', 'approved') == 'approved';
    }

    function deletingOwner(groupId) {
      return isOwner(groupId)
        && get(/databases/$(db)/documents/groups/$(groupId)).data.get('deletionState', '') == 'deleting';
    }

    // 接続が残っている間は復旧先を捨てたり別世帯に付け替えたりできない。
    // 同じbatchの退会/最終削除は、変更後の状態で判定する。
    function connectionReleasedAfter(groupId) {
      return !existsAfter(/databases/$(db)/documents/groups/$(groupId))
        || (getAfter(/databases/$(db)/documents/groups/$(groupId)).data.createdBy != request.auth.uid
          && !existsAfter(/databases/$(db)/documents/groups/$(groupId)/members/$(request.auth.uid)));
    }

    function mayChooseGroup(groupId) {
      return !exists(/databases/$(db)/documents/accounts/$(request.auth.uid))
        || get(/databases/$(db)/documents/accounts/$(request.auth.uid)).data.groupId == groupId
        || connectionReleasedAfter(get(/databases/$(db)/documents/accounts/$(request.auth.uid)).data.groupId);
    }

    function isApproved(groupId) {
      return signedIn() && !exists(/databases/$(db)/documents/accountClosures/$(request.auth.uid)) && isActive(groupId)
        && exists(/databases/$(db)/documents/groups/$(groupId)/members/$(request.auth.uid))
        && get(/databases/$(db)/documents/groups/$(groupId)/members/$(request.auth.uid))
          .data.get('status', 'approved') == 'approved';
    }

    /* ===== 管理者の交代 (2026-10-02) =====
       今の管理者が依頼(pendingOwner/pendingOwnerAt)し、引継先が自分で受け取る2段階。
       依頼は24時間有効。受け取るときは管理者の入れ替えと依頼の削除を1回で確定する。 */
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    function startDeletion(groupId) {
      return isOwner(groupId)
        && changed().hasOnly(['deletionState', 'deletionStartedAt'])
        && request.resource.data.deletionState == 'deleting'
        && request.resource.data.deletionStartedAt == request.time;
    }
    // 引継先になれるのは、承認済みの「家族」(本人の画面で使う人は除く)
    function transferTarget(groupId, target) {
      return target is string && target != request.auth.uid
        && exists(/databases/$(db)/documents/groups/$(groupId)/members/$(target))
        && get(/databases/$(db)/documents/groups/$(groupId)/members/$(target)).data.get('status', 'approved') == 'approved'
        && get(/databases/$(db)/documents/groups/$(groupId)/members/$(target)).data.get('role', '') == 'kazoku'
        && get(/databases/$(db)/documents/groups/$(groupId)/members/$(target)).data.get('mode', 'kazoku') != 'honnin';
    }
    function requestTransfer(groupId) {
      return isOwner(groupId) && hasConsent()
        && changed().hasOnly(['pendingOwner', 'pendingOwnerAt'])
        && request.resource.data.keys().hasAll(['pendingOwner', 'pendingOwnerAt'])
        && request.resource.data.pendingOwnerAt == request.time
        && transferTarget(groupId, request.resource.data.pendingOwner);
    }
    // 取り消し(今の管理者)・断る(引継先)。期限切れの依頼の片付けも同じ。
    function clearTransfer(groupId) {
      return 'pendingOwner' in resource.data
        && (isOwner(groupId) || resource.data.pendingOwner == request.auth.uid)
        && changed().hasOnly(['pendingOwner', 'pendingOwnerAt'])
        && !('pendingOwner' in request.resource.data)
        && !('pendingOwnerAt' in request.resource.data);
    }
    // 受け取り: 引継先本人が、復旧設定(メール確認済み)のパスワードで5分以内に入れ直してから。
    function acceptTransfer(groupId) {
      return 'pendingOwner' in resource.data
        && resource.data.pendingOwner == request.auth.uid
        && resource.data.pendingOwnerAt is timestamp
        && request.time < resource.data.pendingOwnerAt + duration.value(24, 'h')
        && changed().hasOnly(['createdBy', 'pendingOwner', 'pendingOwnerAt'])
        && request.resource.data.createdBy == request.auth.uid
        && !('pendingOwner' in request.resource.data)
        && !('pendingOwnerAt' in request.resource.data)
        && isApproved(groupId) && hasConsent()
        && transferTargetSelf(groupId)
        && exists(/databases/$(db)/documents/accounts/$(request.auth.uid))
        && get(/databases/$(db)/documents/accounts/$(request.auth.uid)).data.groupId == groupId
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.time < timestamp.value(request.auth.token.auth_time * 1000) + duration.value(5, 'm');
    }
    function transferTargetSelf(groupId) {
      return get(/databases/$(db)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.get('role', '') == 'kazoku'
        && get(/databases/$(db)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.get('mode', 'kazoku') != 'honnin';
    }

    match /groups/{groupId} {
      allow create: if usableAccount() && hasConsent()
        && request.resource.data.keys().hasOnly(['createdBy', 'createdAt'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && mayChooseGroup(groupId)
        && getAfter(/databases/$(db)/documents/accounts/$(request.auth.uid)).data.groupId == groupId
        && getAfter(/databases/$(db)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.status == 'approved';

      // 不存在を読み取れることは削除完了確認に必要。存在する世帯は非公開。
      allow get: if signedIn() && (
        !exists(/databases/$(db)/documents/groups/$(groupId))
        || isOwner(groupId) || isApproved(groupId));
      allow list: if signedIn() && resource.data.createdBy == request.auth.uid;
      // 削除マークは不可逆。作成者の付け替えは、下の「管理者の交代」の受け取りだけ。
      // (2026-10-02 作り直し第2回) 更新は次の4つだけ。操作ごとに変えてよい項目を限る。
      //   ①削除を始める ②交代を依頼する ③依頼を取り消す・断る ④交代を受け取る
      allow update: if isActive(groupId) && (
        startDeletion(groupId)
        || (usableAccount() && (requestTransfer(groupId)
          || clearTransfer(groupId) || acceptTransfer(groupId))));
      allow delete: if deletingOwner(groupId);

      match /members/{uid} {
        allow get: if isOwner(groupId) || isApproved(groupId)
          || (signedIn() && isActive(groupId) && request.auth.uid == uid);
        allow list: if isOwner(groupId) || isApproved(groupId);

        allow create: if signedIn() && hasConsent() && writableGroup(groupId)
          && request.auth.uid == uid
          && mayChooseGroup(groupId)
          && request.resource.data.keys().hasOnly([
            'name', 'role', 'mode', 'status', 'joinedAt', 'inviteCode'
          ])
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 80
          && request.resource.data.role in ['honnin', 'kazoku']
          && request.resource.data.get('mode', 'kazoku') in ['honnin', 'kazoku', 'konly']
          && request.resource.data.joinedAt == request.time
          && (
            (getAfter(/databases/$(db)/documents/groups/$(groupId)).data.createdBy == request.auth.uid
              && request.resource.data.status == 'approved')
            || (
              request.resource.data.status == 'pending'
              && request.resource.data.inviteCode is string
              && get(/databases/$(db)/documents/invites/$(request.resource.data.inviteCode)).data.groupId == groupId
              && get(/databases/$(db)/documents/invites/$(request.resource.data.inviteCode)).data.used == false
              && get(/databases/$(db)/documents/invites/$(request.resource.data.inviteCode)).data.expiresAt > request.time
              // 参加申請と使用済み化を同じ batch/transaction に固定する。
              && getAfter(/databases/$(db)/documents/invites/$(request.resource.data.inviteCode)).data.used == true
              && getAfter(/databases/$(db)/documents/invites/$(request.resource.data.inviteCode)).data.usedBy == request.auth.uid
            )
          );

        allow update: if (activeOwner(groupId)
          && resource.data.status == 'pending'
          && request.resource.data.status == 'approved'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
          || (signedIn() && request.auth.uid == uid
            && isApproved(groupId) && writableGroup(groupId)
            && request.resource.data.mode in ['honnin', 'kazoku', 'konly']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mode']));

        // 作成者は通常退会できない。全体削除は最後まで作成者を識別できる。
        allow delete: if deletingOwner(groupId)
          || (isActive(groupId)
            && uid != get(/databases/$(db)/documents/groups/$(groupId)).data.createdBy
            && (activeOwner(groupId) || (signedIn() && request.auth.uid == uid)));
      }

      /* 記録の種類(2026-10-01): アプリが書く種類だけを受け付ける。
         LINE連携の記録は送信役(サーバー)が書く。家族がアプリから書けるのは「アプリから解除した」記録だけ。
         「ひと声のきっかけ」への了解は、ご本人だけが書ける。 */
      function isHonninMember(groupId) {
        return get(/databases/$(db)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.get('role', '') == 'honnin'
          || get(/databases/$(db)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.get('mode', '') == 'honnin';
      }
      function validEventType(groupId, d) {
        return d.get('type', '') in [
            'aisatsu', 'aisatsu-back', 'kusuri', 'kusuri-kakunin', 'ask-kusuri', 'kibun', 'kibun-kazoku', 'kibun-config',
            'onegai', 'onegai-back', 'memo', 'care-log', 'care-config', 'member-joined', 'medicine-info', 'family-contact',
            'family-message', 'family-message-back', 'family-note', 'family-note-ack', 'family-note-reply',
            'family-task', 'family-task-done', 'family-task-help', 'person-ui-config', 'tag-alert',
            'yotei-note', 'yotei-cat-config', 'line-link-log',
            'disaster-safe', 'disaster-evacuating', 'disaster-help',
            'hitokoe-config', 'hitokoe-consent', 'hitokoe-contacted', 'device-recovery'
          ]
          && (d.type != 'line-link-log' || (d.get('action', '') == 'unlinked' && d.get('via', '') == 'app'))
          && (d.type != 'hitokoe-consent' || isHonninMember(groupId));
      }

      match /events/{eventId} {
        allow read: if (isApproved(groupId) && hasConsent()) || deletingOwner(groupId);
        allow create: if isApproved(groupId) && hasConsent() && writableGroup(groupId)
          && request.resource.data.uid == request.auth.uid
          && validEventType(groupId, request.resource.data);
        allow update: if false;
        allow delete: if deletingOwner(groupId) || (usableAccount() && isApproved(groupId)
          && resource.data.uid == request.auth.uid);
      }

      /* 予定の追加項目(2026-09-26): 場所(60文字まで)と、LINEで知らせる日時。
         (2026-09-28) 分類(20文字まで・空欄可)を追加。
         notifiedAt(送信済みの印)は送信役(サーバー)だけが書く。 */
      function validYoteiExtras(d) {
        return (!('place' in d) || (d.place is string && d.place.size() <= 60))
          && (!('notifyAt' in d) || d.notifyAt == null || d.notifyAt is timestamp)
          && (!('category' in d) || (d.category is string && d.category.size() <= 20))
          // LINEで知らせる相手(2026-10-04)。null=つないだ家族全員。'u:<uid>'(家族)・'r:<id>'(招待した送信先)を20件まで
          && (!('notifyTo' in d) || d.notifyTo == null || (d.notifyTo is list && d.notifyTo.size() <= 20));
      }

      /* アプリを使わない人(招待した送信先)へ予定を送る同意(2026-10-04)。
         この機能を使う家族だけが、使う前に本人として同意する。ご本人の了解を得たことも確かめる。
         同意した家族だけが送信先・招待を作れ、送信役も送る直前にこの同意を確かめる。やめるときは削除する。 */
      match /lineShareConsents/{uid} {
        allow get, list: if isApproved(groupId) && hasConsent();
        allow create: if request.auth.uid == uid && isApproved(groupId) && hasConsent() && writableGroup(groupId)
          && request.resource.data.keys().hasOnly(['version', 'acceptedAt', 'honninAgreed', 'name'])
          && request.resource.data.version in ['line-share-20261004']
          && request.resource.data.acceptedAt == request.time
          && request.resource.data.honninAgreed == true
          && request.resource.data.name is string && request.resource.data.name.size() <= 40;
        allow update: if false;
        allow delete: if signedIn() && request.auth.uid == uid;
      }

      match /yotei/{yoteiId} {
        allow read: if (isApproved(groupId) && hasConsent()) || deletingOwner(groupId);

        /* 新規作成: 自分名義のみ・9項目限定・作成/更新時刻はサーバー時刻 */
        allow create: if isApproved(groupId) && hasConsent() && writableGroup(groupId)
          && request.resource.data.get('uid', null) == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'kind', 'date', 'time', 'label', 'color', 'repeat',
            'uid', 'createdAt', 'updatedAt', 'place', 'notifyAt', 'category', 'notifyTo'
          ])
          && validYoteiExtras(request.resource.data)
          && request.resource.data.keys().hasAll([
            'kind', 'date', 'time', 'label', 'color', 'repeat',
            'uid', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.get('createdAt', null) == request.time
          && request.resource.data.get('updatedAt', null) == request.time;

        /* 修正: 登録した本人だけ(2026-09-10 理絵さん決定)。
           旧データに古い項目が残っていても直せるよう、
           「変更された項目」だけを許可リストで検査する。
           createdAtはリスト外=書き換え不可。
           uidの変更は、名義の無い旧予定を家族が引き継ぐ場合のみ許可。 */
        allow update: if isApproved(groupId) && hasConsent() && writableGroup(groupId)
          && (resource.data.get('uid', null) == null
              || resource.data.get('uid', null) == request.auth.uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'kind', 'date', 'time', 'label', 'color', 'repeat', 'uid', 'updatedAt',
            'place', 'notifyAt', 'category', 'notifyTo'
          ])
          && validYoteiExtras(request.resource.data)
          && request.resource.data.get('updatedAt', null) == request.time
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid'])
            || (resource.data.get('uid', null) == null
                && request.resource.data.get('uid', null) == request.auth.uid)
          );

        /* 削除: 登録した本人だけ(名義の無い旧予定は承認済み家族が整理可) */
        allow delete: if deletingOwner(groupId) || (usableAccount() && isApproved(groupId)
          && (resource.data.get('uid', null) == null
              || resource.data.get('uid', null) == request.auth.uid));
      }

      // QRおまもりタグの家族側設定
      match /settings/watchTag {
        allow get: if (isApproved(groupId) && hasConsent()) || deletingOwner(groupId);
        allow list: if deletingOwner(groupId);

        allow create: if activeOwner(groupId) && hasConsent()
          && request.resource.data.keys().hasOnly([
            'watchTagId', 'watchTagActive', 'watchTagUpdatedAt'
          ])
          && request.resource.data.watchTagId is string
          && request.resource.data.watchTagId.matches('^[A-Za-z0-9_-]{32}$')
          && request.resource.data.watchTagActive == true
          && request.resource.data.watchTagUpdatedAt == request.time
          && getAfter(/databases/$(db)/documents/watchTags/$(request.resource.data.watchTagId))
            .data.groupId == groupId
          && getAfter(/databases/$(db)/documents/watchTags/$(request.resource.data.watchTagId))
            .data.active == true;

        allow update: if activeOwner(groupId)
          && request.resource.data.keys().hasOnly([
            'watchTagId', 'watchTagActive', 'watchTagUpdatedAt'
          ])
          && request.resource.data.watchTagId is string
          && request.resource.data.watchTagId.matches('^[A-Za-z0-9_-]{32}$')
          && request.resource.data.watchTagActive is bool
          && request.resource.data.watchTagUpdatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'watchTagId', 'watchTagActive', 'watchTagUpdatedAt'
          ])
          && getAfter(/databases/$(db)/documents/watchTags/$(request.resource.data.watchTagId))
            .data.groupId == groupId
          && getAfter(/databases/$(db)/documents/watchTags/$(request.resource.data.watchTagId))
            .data.active == request.resource.data.watchTagActive;

        allow delete: if deletingOwner(groupId);
      }
    }

    // Auth削除後も旧IDトークンを拒否する最小の閉鎖記録。クライアントから解除不可。
    match /accountClosures/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['requestedAt'])
        && request.resource.data.requestedAt == request.time;
      allow list, update, delete: if false;
    }

    /* 家族の1分アンケート(2026-10-05・試験運用の評価用・任意)。
       答えた本人だけが読み書きでき、ほかの家族には見えない。1人1か月1件(番号は「利用者ID_年-月」)。
       全体の数字だけを、送信役(サーバー)が運営者に返す。 */
    match /surveyAnswers/{id} {
      allow get, list: if signedIn() && resource.data.uid == request.auth.uid;
      allow create, update: if hasConsent()
        && request.resource.data.keys().hasOnly(['uid', 'groupId', 'month', 'kind', 'absences', 'burden', 'answeredAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.month is string
        && request.resource.data.month.matches('^20[0-9]{2}-(0[1-9]|1[0-2])$')
        && id == request.auth.uid + '_' + request.resource.data.month
        && request.resource.data.kind in ['baseline', 'monthly']
        && request.resource.data.absences in [-1, 0, 1, 2, 4]
        && request.resource.data.burden in ['', 'less', 'same', 'more', 'unknown']
        && (request.resource.data.kind == 'monthly' || request.resource.data.burden == '')
        && request.resource.data.answeredAt == request.time
        && request.resource.data.groupId is string
        && isApproved(request.resource.data.groupId) && writableGroup(request.resource.data.groupId)
        && (resource == null || resource.data.uid == request.auth.uid);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // 復旧先だけを保存。一般家族に他人の認証UIDの検索は許可しない。
    match /accounts/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if deletingOwner(resource.data.groupId);
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['groupId', 'updatedAt'])
        && request.resource.data.groupId is string
        && request.resource.data.updatedAt == request.time
        && approvedAfter(request.resource.data.groupId)
        && mayChooseGroup(request.resource.data.groupId);
      allow delete: if (signedIn() && request.auth.uid == uid
          && connectionReleasedAfter(resource.data.groupId))
        || (signedIn() && request.auth.uid != uid && deletingOwner(resource.data.groupId));
    }

    // LINE連携コード(予定のお知らせ用・2026-09-26)。
    // 承認済みの本人名義で作り、10分だけ有効。照合と連携は送信役(サーバー)が行う。
    /* ご本人の新しいスマホを再接続QRでつなぐ(2026-10-05・作り直し設計書 A2)。
       家族(承認済み・同意あり・ご本人ではない)が、同じ家庭のご本人あての1回限り・10分のコードを作る。
       コードの照合と、ご本人のUIDでのログインは送信役(サーバー)だけが行う。作った家族は確認と取り消しができる。 */
    match /reconnectCodes/{code} {
      function memberDoc(groupId, uid) { return get(/databases/$(db)/documents/groups/$(groupId)/members/$(uid)).data; }
      function honninDoc(m) { return m.get('role', '') == 'honnin' || m.get('mode', '') == 'honnin'; }
      allow get: if signedIn() && resource.data.createdBy == request.auth.uid;
      allow list, update: if false;
      allow create: if code.matches('^[A-HJ-NP-Z2-9]{16}$')
        && request.resource.data.keys().hasOnly(['groupId', 'targetUid', 'createdBy', 'createdAt', 'expiresAt'])
        && request.resource.data.groupId is string && request.resource.data.targetUid is string
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.targetUid != request.auth.uid
        && isApproved(request.resource.data.groupId) && hasConsent()
        && writableGroup(request.resource.data.groupId)
        && !honninDoc(memberDoc(request.resource.data.groupId, request.auth.uid))
        && exists(/databases/$(db)/documents/groups/$(request.resource.data.groupId)/members/$(request.resource.data.targetUid))
        && memberDoc(request.resource.data.groupId, request.resource.data.targetUid).get('status', 'approved') == 'approved'
        && honninDoc(memberDoc(request.resource.data.groupId, request.resource.data.targetUid))
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(11, 'm');
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }

    match /lineLinkCodes/{code} {
      allow get: if signedIn() && resource.data.uid == request.auth.uid;
      allow list: if false;
      allow create: if code.matches('^[A-HJ-NP-Z2-9]{8}$')
        && request.resource.data.keys().hasOnly(['uid', 'groupId', 'createdAt', 'expiresAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.groupId is string
        && isApproved(request.resource.data.groupId) && hasConsent()
        && writableGroup(request.resource.data.groupId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(11, 'm');
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // LINEの送信先(招待・2026-10-04)。アプリを使わない人にも、選んだ予定のお知らせだけをLINEで届ける。
    // 家族(承認済み)が名前を入れて作り、相手がLINEで招待コードを送ると、送信役(サーバー)が「登録済み」にする。
    // LINEの利用者識別子はここに置かない(送信役だけが読む lineRecipientIds に置く)。
    match /lineRecipients/{rid} {
      function validRecipientName(n) { return n is string && n.size() >= 1 && n.size() <= 40; }
      allow get, list: if resource.data.groupId is string && isApproved(resource.data.groupId) && hasConsent();
      allow create: if request.resource.data.keys().hasOnly(['groupId', 'name', 'status', 'createdBy', 'createdAt'])
        && request.resource.data.groupId is string
        && isApproved(request.resource.data.groupId) && hasConsent()
        && writableGroup(request.resource.data.groupId)
        && validRecipientName(request.resource.data.name)
        && request.resource.data.status == 'pending'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(db)/documents/groups/$(request.resource.data.groupId)/lineShareConsents/$(request.auth.uid));
      // 家族が変えられるのは名前だけ(状態・LINE名・登録日時は送信役が書く)
      allow update: if isApproved(resource.data.groupId) && hasConsent()
        && writableGroup(resource.data.groupId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && validRecipientName(request.resource.data.name);
      allow delete: if isApproved(resource.data.groupId) && hasConsent();
    }
    match /lineRecipientIds/{rid} {
      allow read, write: if false;
    }
    // 送信先への招待コード(10文字・7日間)。照合は送信役が行う。
    match /lineInvites/{code} {
      allow get: if signedIn() && resource.data.createdBy == request.auth.uid;
      allow list, update: if false;
      allow create: if code.matches('^[A-HJ-NP-Z2-9]{10}$')
        && request.resource.data.keys().hasOnly(['groupId', 'recipientId', 'createdBy', 'createdAt', 'expiresAt'])
        && request.resource.data.groupId is string && request.resource.data.recipientId is string
        && isApproved(request.resource.data.groupId) && hasConsent()
        && writableGroup(request.resource.data.groupId)
        && request.resource.data.createdBy == request.auth.uid
        && exists(/databases/$(db)/documents/groups/$(request.resource.data.groupId)/lineShareConsents/$(request.auth.uid))
        && exists(/databases/$(db)/documents/lineRecipients/$(request.resource.data.recipientId))
        && get(/databases/$(db)/documents/lineRecipients/$(request.resource.data.recipientId)).data.groupId == request.resource.data.groupId
        && get(/databases/$(db)/documents/lineRecipients/$(request.resource.data.recipientId)).data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(7, 'd') + duration.value(1, 'h');
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }

    // 今月のLINEの残り通数(2026-10-01)。送信役だけが書き、同意済みの利用者は見られる(まいにこ全体で共通の数)。
    match /lineStatus/{docId} {
      allow get: if hasConsent();
      allow list, create, update, delete: if false;
    }

    // LINE連携の状態。書き込みは送信役(サーバー)だけ。本人は確認と解除ができる。
    match /lineLinks/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create, update: if false;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // LINEでログイン(2026-10-01)。つながりの記録・手続きは送信役(サーバー)だけが作成・変更・削除する。
    // 本人は自分のアカウントがLINEでログインできるか(とその日時)だけを見られる。LINEの識別子は持たない。
    match /lineLoginAccounts/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    match /lineLoginLinks/{lineKey} {
      allow read, write: if false;
    }
    match /lineAuthTx/{txId} {
      allow read, write: if false;
    }

    match /invites/{code} {
      // 招待コードを知っている参加者は、削除中でない有効世帯の申請に使える。
      allow get: if signedIn() && (isActive(resource.data.groupId) || deletingOwner(resource.data.groupId));
      allow list: if isOwner(resource.data.groupId);
      allow create: if signedIn()
        && code.matches('^[A-HJ-NP-Z2-9]{8}$')
        && request.resource.data.keys().hasOnly(['groupId', 'createdBy', 'createdAt', 'expiresAt', 'used'])
        && request.resource.data.groupId is string
        && activeOwner(request.resource.data.groupId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(25, 'h')
        && request.resource.data.used == false;
      allow update: if signedIn() && writableGroup(resource.data.groupId)
        && resource.data.used == false
        && resource.data.expiresAt > request.time
        && request.resource.data.used == true
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedBy'])
        && !exists(/databases/$(db)/documents/groups/$(resource.data.groupId)/members/$(request.auth.uid))
        && getAfter(/databases/$(db)/documents/groups/$(resource.data.groupId)/members/$(request.auth.uid)).data.status == 'pending'
        && getAfter(/databases/$(db)/documents/groups/$(resource.data.groupId)/members/$(request.auth.uid)).data.inviteCode == code;
      allow delete: if activeOwner(resource.data.groupId) || deletingOwner(resource.data.groupId);
    }

    // QRおまもりタグ本体
    match /watchTags/{tagId} {
      allow get: if (isApproved(resource.data.groupId) && hasConsent()) || deletingOwner(resource.data.groupId);
      allow list: if isOwner(resource.data.groupId);

      allow create: if signedIn()
        && tagId.matches('^[A-Za-z0-9_-]{32}$')
        && request.resource.data.keys().hasOnly([
          'groupId', 'active', 'createdBy', 'createdAt', 'consentVersion', 'consentedAt'
        ])
        && request.resource.data.groupId is string
        && request.resource.data.active == true
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && activeOwner(request.resource.data.groupId) && hasConsent()
        && request.resource.data.consentVersion == '2026-09-19.1'
        && request.resource.data.consentedAt == request.time;

      allow update: if activeOwner(resource.data.groupId)
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.active == false
        && request.resource.data.stoppedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'active', 'stoppedAt'
        ]);

      allow delete: if deletingOwner(resource.data.groupId);

      match /alerts/{alertId} {
        allow create: if signedIn()
          && alertId == request.auth.uid
          && exists(/databases/$(db)/documents/watchTags/$(tagId))
          && get(/databases/$(db)/documents/watchTags/$(tagId)).data.active == true
          && writableGroup(get(/databases/$(db)/documents/watchTags/$(tagId)).data.groupId)
          && request.resource.data.keys().hasOnly([
            'type', 'situation', 'count', 'senderUid', 'createdAt'
          ])
          && request.resource.data.type == 'found'
          && request.resource.data.situation in ['lost', 'unwell', 'safe', 'called']
          && request.resource.data.count == 1
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.createdAt == request.time;

        allow update: if signedIn()
          && alertId == request.auth.uid
          && exists(/databases/$(db)/documents/watchTags/$(tagId))
          && get(/databases/$(db)/documents/watchTags/$(tagId)).data.active == true
          && writableGroup(get(/databases/$(db)/documents/watchTags/$(tagId)).data.groupId)
          && request.resource.data.keys().hasOnly([
            'type', 'situation', 'count', 'senderUid', 'createdAt'
          ])
          && request.resource.data.type == 'found'
          && request.resource.data.situation in ['lost', 'unwell', 'safe', 'called']
          && request.resource.data.count == resource.data.get('count', 0) + 1
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.time > resource.data.createdAt + duration.value(10, 'm');

        allow read: if (hasConsent() && isApproved(get(/databases/$(db)/documents/watchTags/$(tagId)).data.groupId))
          || deletingOwner(get(/databases/$(db)/documents/watchTags/$(tagId)).data.groupId);
        allow delete: if deletingOwner(get(/databases/$(db)/documents/watchTags/$(tagId)).data.groupId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
